{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?path=$1"
    },
    {
      "source": "/web/(.*)",
      "destination": "/$1"
    }
  ]
}
